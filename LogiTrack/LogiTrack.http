@LogiTrack_HostAddress = http://localhost:5160

### ==============================================
### SYSTEM HEALTH & DISCOVERY
### ==============================================

### 1. Health Check
GET {{LogiTrack_HostAddress}}/health
Accept: application/json

### 2. API Discovery & Landing
GET {{LogiTrack_HostAddress}}/
Accept: application/json

### ==============================================
### AUTHENTICATION ENDPOINTS (Part 3)
### ==============================================

### 3. Register a new User
POST {{LogiTrack_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "warehouse_staff",
  "email": "staff@logitrack.com",
  "password": "StaffPassword123!",
  "role": "User"
}

### 4. Login as Manager to get JWT Token
# @name loginManager
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "manager",
  "password": "Manager123!"
}

### 5. Login as Regular Staff (User)
# @name loginUser
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "user",
  "password": "User123!"
}

### Save Token from Login Response
@managerToken = {{loginManager.response.body.token}}
@userToken = {{loginUser.response.body.token}}

### ==============================================
### INVENTORY ENDPOINTS [CACHED & PROTECTED]
### ==============================================

### 6. Get all inventory items (Cached 30s)
GET {{LogiTrack_HostAddress}}/api/inventory
Authorization: Bearer {{userToken}}
Accept: application/json

### 7. Get inventory item by ID
GET {{LogiTrack_HostAddress}}/api/inventory/1
Authorization: Bearer {{userToken}}
Accept: application/json

### 8. Add a new inventory item (Requires Role: Manager - Invalidates Cache)
POST {{LogiTrack_HostAddress}}/api/inventory
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Heavy Duty Pallet Stacker",
  "quantity": 10,
  "location": "Warehouse C"
}

### 9. Delete inventory item by ID (Requires Role: Manager - Invalidates Cache)
DELETE {{LogiTrack_HostAddress}}/api/inventory/1
Authorization: Bearer {{managerToken}}
Accept: application/json

### ==============================================
### ORDER ENDPOINTS [STATE PERSISTENCE & CACHED]
### ==============================================

### 10. Get all orders (Cached 30s)
GET {{LogiTrack_HostAddress}}/api/orders
Authorization: Bearer {{userToken}}
Accept: application/json

### 11. Get orders by SessionId (Session State Rehydration)
GET {{LogiTrack_HostAddress}}/api/orders?sessionId=session_cart_101
Authorization: Bearer {{userToken}}
Accept: application/json

### 12. Get order by ID with items
GET {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{userToken}}
Accept: application/json

### 13. Create a new persistent order with multiple items and SessionId
POST {{LogiTrack_HostAddress}}/api/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "customerName": "Elena Rostova",
  "datePlaced": "2026-10-10T08:30:00Z",
  "sessionId": "session_cart_101",
  "status": "Pending",
  "items": [
    {
      "name": "Barcode Scanner Pro",
      "quantity": 3,
      "location": "Warehouse A"
    },
    {
      "name": "Industrial Hand Truck",
      "quantity": 2,
      "location": "Warehouse C"
    }
  ]
}

### 14. Update order status (Lifecycle management)
PATCH {{LogiTrack_HostAddress}}/api/orders/1/status
Authorization: Bearer {{managerToken}}
Content-Type: application/json

"Processing"

### 15. Delete order by ID (Requires Role: Manager)
DELETE {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{managerToken}}
Accept: application/json
