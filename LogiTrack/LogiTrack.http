@LogiTrack_HostAddress = http://localhost:5160

### ==============================================
### AUTHENTICATION ENDPOINTS (Part 3)
### ==============================================

### 1. Register a new Manager
POST {{LogiTrack_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "warehouse_manager",
  "email": "manager2@logitrack.com",
  "password": "ManagerPassword123!",
  "role": "Manager"
}

### 2. Login as Manager to get JWT Token
# @name loginManager
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "manager",
  "password": "Manager123!"
}

### 3. Login as Regular Staff (User)
# @name loginUser
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "user",
  "password": "User123!"
}

### Save Token from Login Response
@managerToken = {{loginManager.response.body.token}}
@userToken = {{loginUser.response.body.token}}

### ==============================================
### INVENTORY ENDPOINTS [PROTECTED]
### ==============================================

### 4. Get all inventory items (Requires Authentication)
GET {{LogiTrack_HostAddress}}/api/inventory
Authorization: Bearer {{userToken}}
Accept: application/json

### 5. Get inventory item by ID (Requires Authentication)
GET {{LogiTrack_HostAddress}}/api/inventory/1
Authorization: Bearer {{userToken}}
Accept: application/json

### 6. Add a new inventory item (Requires Role: Manager)
POST {{LogiTrack_HostAddress}}/api/inventory
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Industrial Pallet Jack",
  "quantity": 8,
  "location": "Warehouse C"
}

### 7. Delete inventory item by ID (Requires Role: Manager)
DELETE {{LogiTrack_HostAddress}}/api/inventory/1
Authorization: Bearer {{managerToken}}
Accept: application/json

### ==============================================
### ORDER ENDPOINTS [PROTECTED]
### ==============================================

### 8. Get all orders (Requires Authentication)
GET {{LogiTrack_HostAddress}}/api/orders
Authorization: Bearer {{userToken}}
Accept: application/json

### 9. Get order by ID with items (Requires Authentication)
GET {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{userToken}}
Accept: application/json

### 10. Create a new order with items (Requires Authentication)
POST {{LogiTrack_HostAddress}}/api/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "customerName": "Elena Rostova",
  "datePlaced": "2026-10-10T08:30:00Z",
  "items": [
    {
      "name": "Barcode Scanner",
      "quantity": 3,
      "location": "Warehouse A"
    },
    {
      "name": "Heavy Duty Hand Truck",
      "quantity": 2,
      "location": "Warehouse C"
    }
  ]
}

### 11. Delete order by ID (Requires Role: Manager)
DELETE {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{managerToken}}
Accept: application/json
